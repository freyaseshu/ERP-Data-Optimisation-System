# Copy to .env.production; set ERP_ENV_FILE to that file before launching Python.
# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
PUBLIC_BASE_URL=https://erp.example.com
DATABASE_URL=postgresql+psycopg://erp_app:replace-owner-password@127.0.0.1:5432/erp_optimisation_db
READONLY_DATABASE_URL=postgresql+psycopg://erp_reader:replace-reader-password@127.0.0.1:5432/erp_optimisation_db
QUERY_TIMEOUT_MS=5000
SLOW_QUERY_MS=100
ERP_BIND_HOST=127.0.0.1
ERP_PORT=8080
ERP_THREADS=4
# Trust only the reverse proxy's actual peer IP. Never use '*'.
ERP_TRUSTED_PROXY=127.0.0.1
