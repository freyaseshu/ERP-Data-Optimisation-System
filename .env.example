DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/erp_optimisation_db
SECRET_KEY=replace-with-a-random-secret
QUERY_TIMEOUT_MS=5000
SLOW_QUERY_MS=100
APP_ENV=development
# Waitress: run serve.ps1 and open http://127.0.0.1:8080
ERP_BIND_HOST=127.0.0.1
ERP_PORT=8080
ERP_THREADS=4

# Optional: provision with scripts/configure_readonly.py or supply a SELECT-only role URL.
# READONLY_DATABASE_URL=postgresql+psycopg://erp_reader:password@localhost:5432/erp_optimisation_db
